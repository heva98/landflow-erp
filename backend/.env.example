DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://landflow:landflow@localhost:5432/landflow

CORS_ALLOWED_ORIGINS=http://localhost:5173

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Defaults to printing emails to the console. Switch to the SMTP backend and
# fill in the vars below for real delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=LandFlow ERP <noreply@landflow.co.tz>

# Leave AWS_STORAGE_BUCKET_NAME blank to store uploads on local disk (dev
# default). Set it (plus the vars below) to switch every FileField in the
# project to S3-compatible object storage — no code changes needed.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Leave blank for real AWS S3; set for an S3-compatible provider (e.g. MinIO,
# DigitalOcean Spaces, Cloudflare R2).
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
